!! Using of additional raster to modify DTM via Read Grid Zpts features for DTM modification  
!! Summary:
!! - rasters
!! - channels, culverts, levees
!! - CWF, FLC
!! - other gpkg etc.
{% if buildings %}
Read Grid ZptsADD XF OFF == grid\dtm_buildings_{{ domain }}.tif
{% else %}
!Read Grid ZptsADD XF OFF == grid\dtm_buildings_{{ domain }}.tif
{% endif %}
{% if wb %}
Read Grid ZptsADD == grid\dtm_wb_{{ domain }}.tif
{% else %}
!Read Grid ZptsADD == grid\dtm_wb_{{ domain }}.tif
{% endif %}

!! Using of (building) raster to create CWF / FLC modification ( mainly for pluvial simulation)  
!! Cell Width Factor - for example 0.1 will limit the flow width to 10 %.The changed flow width applies to all depths.
!! Form Loss Coefficient - can be used to apply an additional energy loss at the 2D cell side
{% if cwf_buildings %}
Read GRID CWF XF OFF == grid\cwf_buildings_{{ domain }}.tif
Read GRID SRF XF OFF == grid\cwf_buildings_{{ domain }}.tif
{% else %}
!Read GRID CWF XF OFF == grid\cwf_buildings_{{ domain }}.tif
!Read GRID SRF XF OFF == grid\cwf_buildings_{{ domain }}.tif
{% endif %}

!Read GRID FLC XF OFF == grid\dtm_buildings_{{ domain }}.tif
 

!! Using of Zpt features for DTM modification

!Read GIS Z Shape == gis\2d_files_{{ domain }}.gpkg >> USE ALL

!! "ChnlWB" (shape of channel ) - long  channel with shape of waterbody >> 2-3x  model resolution 
!Read GIS Z Shape min == gis\dtm\2d_zsh_ChnlWB_{{ domain }}.gpkg >> 2d_zsh_ChnlWB_{{ domain }}_R && 2d_zsh_ChnlWB_{{ domain }}_P
{% if order %}
!! "Levee" - levees/embankments  which can cause up water level
{% if levee == True %}
Read GIS Z Shape max == gis\dtm\2d_zsh_levee_{{ domain }}.gpkg >> 2d_zsh_levee_{{ domain }}_L && 2d_zsh_levee_{{ domain }}_P
{% else %}
!Read GIS Z Shape max == gis\dtm\2d_zsh_levee_{{ domain }}.gpkg >> 2d_zsh_levee_{{ domain }}_L && 2d_zsh_levee_{{ domain }}_P
{% endif %}
{% endif %}
!! Culverts - short lines , which dig embankments or other obstacles. Its  size is usually smaller than DTM/model resolution
{% if culvert == True %}
Read GIS Z Shape min == gis\dtm\2d_zsh_culvert_{{ domain }}.gpkg >> 2d_zsh_culvert_{{ domain }}_L && 2d_zsh_culvert_{{ domain }}_P

!! Define CellWidth Factor and Form Loss Coefficient  for culverts 
!Cell Width Factor - for example 0.1 will limit the flow width to 10 %.The changed flow width applies to all depths. 
!Form Loss Coefficient - can be used to apply an additional energy loss at the 2D cell side 
Read GIS CWF == 5 | gis\dtm\2d_zsh_culvert_{{ domain }}.gpkg >> 2d_zsh_culvert_{{ domain }}_L
!Read GIS FLC == 6 | gis\dtm\2d_zsh_culvert_{{ domain }}.gpkg >> 2d_zsh_culvert_{{ domain }}_L
{% else %}
!Read GIS Z Shape min == gis\dtm\2d_zsh_culvert_{{ domain }}.gpkg >> 2d_zsh_culvert_{{ domain }}_L && 2d_zsh_culvert_{{ domain }}_P

!! Define CellWidth Factor and Form Loss Coefficient  for culverts
!Cell Width Factor - for example 0.1 will limit the flow width to 10 %.The changed flow width applies to all depths.
!Form Loss Coefficient - can be used to apply an additional energy loss at the 2D cell side
!Read GIS CWF == 5 | gis\dtm\2d_zsh_culvert_{{ domain }}.gpkg >> 2d_zsh_culvert_{{ domain }}_L
!Read GIS FLC == 6 | gis\dtm\2d_zsh_culvert_{{ domain }}.gpkg >> 2d_zsh_culvert_{{ domain }}_L
{% endif %}
!! "Channel" (channels bed) - long  channel with width >= model resolution with relatively unchanging width, which can be defined by one value for  a line
{% if channel %}
Read GIS Z Shape min == gis\dtm\2d_zsh_channel_{{ domain }}.gpkg >> 2d_zsh_channel_{{ domain }}_L && 2d_zsh_channel_{{ domain }}_P
{% else %}
!Read GIS Z Shape min == gis\dtm\2d_zsh_channel_{{ domain }}.gpkg >> 2d_zsh_channel_{{ domain }}_L && 2d_zsh_channel_{{ domain }}_P
{% endif %}

{% if not order %}
!! "Levee" - levees/embankments  which can cause up water level
{% if levee == True %}
Read GIS Z Shape max == gis\dtm\2d_zsh_levee_{{ domain }}.gpkg >> 2d_zsh_levee_{{ domain }}_L && 2d_zsh_levee_{{ domain }}_P
{% else %}
!Read GIS Z Shape max == gis\dtm\2d_zsh_levee_{{ domain }}.gpkg >> 2d_zsh_levee_{{ domain }}_L && 2d_zsh_levee_{{ domain }}_P
{% endif %}
{% endif %}

!! Place for local inputs like 2d_zsh layers etc.  
!! Preparation for manual user inputs:
!Read GIS Z Shape GULLY ==  gis\dtm\2d_zsh_{{ domain }}.gpkg >> 2d_zsh_{{ domain }}_L && 2d_zsh_{{ domain }}_P
!Read GIS Z Shape ==  gis\dtm\2d_zsh_{{ area }}_WaterBody_R.gpkg
!Read GIS Zpts ADD ==  gis\dtm\2d_zsh_{{ area }}_WaterBody_R.gpkg
!Read GIS IWL ==  gis\dtm\2d_iwl_{{ area }}_WaterBody_R.gpkg				!! Allows the water level to vary spatially in height, for example, to set water levels of lakes.
!Read GIS Z Shape ADD ==  gis\dtm\2d_zsh_x_{{ domain }}_L.gpkg
!Read GIS Z Shape ADD ==  gis\dtm\2d_zsh_x_{{ domain }}_R.gpkg

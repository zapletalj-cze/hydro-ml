!! SOIL & INFILTRATION setup based on infiltration events (e.g. I00 (I); I50; I51)

!! Soils from the "Common Inputs"
!Read File == ..\common\tef_SoilInfiltrationEvent_SGS.tcf
    !Read Soils File == ..\common\Soil_GA_05moist.tsoilf

!Soils directly from the domain
  Define Event == I 
  !! no action 
  End Define
  
  Define Event == I00 
    Read Materials File == ..\common\v25-CAN_Mat_pl.csv 
  !! no action 
  End Define
  
  Define Event == I01 													! Virtual Pipes ON
    Read Soils File == ..\common\Soil\QCforEU\CAN_Soil_GA00_Qxx.tsoilf
	ESTRY Control File == ..\runs\{{ domain }}.ecf 							! linked ESTRY model control file
	Maximum 1D Channels == 200000										! [ <mchan> | {100000} ]    Only used for allocating temporary space.  Memory required only for actual number of channels  (Virtual Pipes) allocated.
  End Define
 
  Define Event == I10 
    Read Soils File == ..\common\Soil\QCforEU\CAN_Soil_GA00_Qxx.tsoilf

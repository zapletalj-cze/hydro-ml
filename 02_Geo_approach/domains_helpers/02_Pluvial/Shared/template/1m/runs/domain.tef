 HPC Infiltration Drying Approach == Method B     !! Method A for Non SGS models

!____________________________________________________________________________________________
!!BC DATABASE (bc_dbase file) setup based on inflow type events (e.g. R;L;C or any RF type)

If Event == R
  BC Database == ..\bc_dbase\bc_dbase_R.csv   !water put into polygon
Else If Event == L
  BC Database == ..\bc_dbase\bc_dbase_L.csv   !water put into stream
Else If Event == C
  BC Database == ..\bc_dbase\bc_dbase_C.csv   !water put into polygon and stream
Else
  BC Database == ..\bc_dbase\bc_dbase_rf.csv  !bc_dbase for RF
End If

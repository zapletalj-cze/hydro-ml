!!Input files were developed for version {{ tuflow_version }} of TUFLOW
!!Configuration file for the flood model

!!	Type of outputs - everytime uncomment
GIS Format == GPKG
Grid Format == TIF

!!PROJECTION COMMANDS
	GPKG Projection == ..\common\01_EPSG_{{ epsg }}.gpkg
	SHP Projection == ..\common\EPSG_{{ epsg }}.prj
	SHP Projection Check Method == PARSED
	GIS Projection Check == ERROR			! {ERROR} | WARNING

!! MODEL INPUTS
	!! Events (bc_dbase,RP,RF's duration,soils&infiltrations,type of IN BC)
	Event File == {{ domain }}.tef

	Read File == ..\common\11_ModelMaterialsAndSettings.tcf

	Geometry Control File == ..\model\{{ domain }}.tgc

	BC Control File == ..\model\{{ domain }}.tbc

!!	MODEL SETUP
!!	Setup GPU and simulation methods

Read File == ..\common\12_ModelSetup.tcf

{% if quadtree == True %}
Read File == ..\model\Quadtree_{{ domain }}.tcf
{% else %}
!Read File == ..\model\Quadtree_{{ domain }}.tcf
{% endif %}

!GPU Device IDs == 0, 1, 2, 3										!! GPU device/devices to be used for the simulation
!HPC Device Split == 1.00, 1.00, 1.00, 1.00							!! To improve device workload efficiencies
!GPU Peer to Peer Access == DISABLED | {ENABLED IF AVAILABLE} 		!! Only for standard HPC (without Quadtree)

!External Stress File == ..\model\wind_Test_{{ domain }}.tesf			!!Specifies the external stress control

!!	TIME
!! Scenario to set Start Time of simulation from 0 hour to 499 hours
Read File == ..\common\13_StartTime.tcf
!Start Time == -st		! hours							! The start time for a simulation specified in Batch File

!! Scenario to set End Time of simulation from 1 hour to 500 hours
Read File == ..\common\14_EndTime.tcf
!End Time == -et		! hours							! The end time for a simulation specified in Batch File

Timestep == 10		! seconds
!Timestep Maximum == 6

!! OUTPUT CONTROL
Log Folder == log
Output Folder == ..\Results

Map Output Format == TIF 								!TIF XMDF 	- XMDF setting for QGIS (Tuflow viewer) and/or if video needed (uncomment line with '..30_XMDF' bellow).

!! Commands for all GRID's outputs setup
	GRID Map Output Data Types == V d h Z0 E
	GRID Output Origin == MODEL ORIGIN
	Store Maximums and Minimums == ON MAXIMUMS ONLY

	Read File == ..\common\15_OutCellSize_ms.tcf		! Output Cell Size = Mesh Cell Size
	Read File == ..\common\15_OutCellSize_os.tcf		! Output Cell Size = 1/2 Mesh Cell Size

!! Commands for TIF's outputs setup
	TIF Compression ==  LZW								! NONE | LZW | {DEFLATE}
!! Commands for XMDF's outputs setup
	!Read File == ..\common\30_XMDF.tcf

!! General ouput time; restart files
If event == I
	Read File == ..\common\16_OutputsGeneral_FL.tcf  	! Creates Restart Files
	Read GIS PO == ..\model\gis\2d_PO_{{ domain }}_L.gpkg
Else
	Read File == ..\common\16_OutputsGeneral_PL.tcf  	! No Restart Files
End If

!! Setup of PO
Start Time Series Output (h)== 1
Time Series Output Interval (s)== 3600  				! Necessary also for VP
Write PO Online == ON
CSV Header Line == SINGLE

!! CHECK FILES
Write Check Files == ..\Check\

If Event == r00005
  If Event == d1440
	!Write Check Files NONE !OFF
    Write Check Files INCLUDE == DEM_Z dom !sac grd 2d_bc_tables bcc
  End If
Else If Event == f00005
    Write Check Files INCLUDE == DEM_Z !2d_bc_tables bcc dom !sac grd
Else
    Write Check Files NONE
   !Write Check Files INCLUDE == 2d_bc_tables bcc
End If

!Write Check Files NONE !OFF

!! Define Restart File by restart type as Hs,He etc.
Read File == Restart_{{ domain }}.tcf
